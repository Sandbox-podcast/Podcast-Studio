# Copy to .env on the LAN host (never commit .env). Placeholders only.

# Reachable from browsers on the Sandbox LAN (hostname or IP — TBD on site)
MINIO_LAN_HOST=REPLACE_WITH_LAN_HOSTNAME_OR_IP

# Host bind for published ports (0.0.0.0 on LAN; 127.0.0.1 for local dev only)
MINIO_BIND_ADDR=0.0.0.0

# Published ports on the LAN host (defaults avoid LiveKit OSS defaults: 7880 HTTP, 7881 TCP)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Container images (locked 2026-10-05 Loïc — override only for lab experiments)
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z@sha256:b6bfe7239bfc83fb90d31612d9704d86039dd714f7904b3f1ad68f211e602372
# MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z@sha256:cfc83108c3abb371f8fb84d99c1fdc88f8c237e022409b0081fb7c0a3be634dd

# MinIO root credentials (generate strong values on the host)
MINIO_ROOT_USER=REPLACE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_ROOT_PASSWORD_MIN_8_CHARS

# Spike recordings bucket (S4 POC)
MINIO_BUCKET_NAME=podcast-recordings-poc

# Server-wide API (not per-bucket): browser presigned PUT + ETag; stale incomplete MPU cleanup
MINIO_API_CORS_ALLOW_ORIGIN=*
MINIO_API_STALE_UPLOADS_EXPIRY=168h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=6h

# Used by mc init container only (internal Docker network)
MINIO_INTERNAL_ENDPOINT=http://minio:9000
