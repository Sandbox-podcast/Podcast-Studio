# Server-side MinIO / S3-compatible endpoint (LAN host TBD — no hardcoded IP in repo)
S3_ENDPOINT=http://REPLACE_WITH_LAN_HOSTNAME_OR_IP:9000
S3_REGION=us-east-1
S3_BUCKET=podcast-recordings-poc
S3_ACCESS_KEY_ID=REPLACE_ME_MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=REPLACE_ME_MINIO_ROOT_PASSWORD

# Optional prefix for lab objects
S3_KEY_PREFIX=spike/s4-lab/
