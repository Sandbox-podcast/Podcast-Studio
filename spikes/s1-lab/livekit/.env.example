# LiveKit Cloud (Build free tier) — copy to .env locally; never commit .env
#
# S1 lab: all participants are in France — use a LiveKit Cloud project in an
# EU region (e.g. eu-central / Frankfurt). Copy the wss URL from that EU project
# dashboard. Strict data residency vs geo latency alone is still TBD (QCM Loïc);
# do not treat this as a compliance policy.
LIVEKIT_URL=wss://your-project.eu.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your_secret_here

# Optional overrides for npm run dev
LAB_HOST=127.0.0.1
LAB_PORT=5179
