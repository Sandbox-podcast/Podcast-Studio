# LiveKit OSS S1 lab — copy to .env locally; never commit .env
#
# Keys must match config/livekit.yaml (placeholder dev values below — rotate for any shared host).
LIVEKIT_KEYS=API_S1_LAB_DEV_PLACEHOLDER: secret_s1_lab_placeholder_not_for_production
LIVEKIT_API_KEY=API_S1_LAB_DEV_PLACEHOLDER
LIVEKIT_API_SECRET=secret_s1_lab_placeholder_not_for_production

# WebSocket URL clients use to reach livekit-server
# Local docker: ws://127.0.0.1:7880
# LAN: ws://<sandbox-lan-ip>:7880  (set by lead — do not invent)
# VPS EU: wss://<fqdn-from-lead>:7880 or ws://<vps-ip>:7880
LIVEKIT_URL=ws://127.0.0.1:7880

# Browser harness (token mint + static UI) — bind localhost unless LAN lab needs 0.0.0.0
LAB_HOST=127.0.0.1
LAB_PORT=5190
