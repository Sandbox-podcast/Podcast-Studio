# Copy to .env.local — never commit real values.

AUTH_SECRET=
AUTH_URL=http://localhost:3000

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Allowlist: comma-separated emails and/or single Workspace/Gmail domain suffix
ALLOWLIST_EMAILS=
ALLOWED_EMAIL_DOMAIN=

# Spike mock roles (replace with Episode Membership in product)
SPIKE_MOCK_ROLE=host
